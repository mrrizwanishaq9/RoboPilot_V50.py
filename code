    # ========================================================
    # LOG
    # ========================================================

    def log(self, text):
        timestamp = time.strftime("%H:%M:%S")
        self.log_box.insert("end", f"[{timestamp}] {text}\n")
        self.log_box.see("end")

    # ========================================================
    # DRAW MAP
    # ========================================================

    def update_display(self):
        self.canvas.delete("all")

        # Grid
        for y in range(GRID_H):
            for x in range(GRID_W):
                x1 = x * CELL
                y1 = y * CELL
                x2 = x1 + CELL
                y2 = y1 + CELL

                value = self.grid[y][x]

                if value == OBSTACLE:
                    fill = "#35434d"
                elif value == START:
                    fill = "#173d2a"
                elif value == GOAL:
                    fill = "#47351c"
                else:
                    fill = "#0b151d"

                self.canvas.create_rectangle(
                    x1, y1, x2, y2,
                    fill=fill,
                    outline="#1d2b34"
                )

        # Path
        if self.path_var.get() and self.path:
            for px, py in self.path:
                cx = px * CELL + CELL // 2
                cy = py * CELL + CELL // 2
                self.canvas.create_oval(
                    cx - 4, cy - 4,
                    cx + 4, cy + 4,
                    fill="#6d8796",
                    outline=""
                )

        # Start
        sx = self.start[0] * CELL + CELL // 2
        sy = self.start[1] * CELL + CELL // 2

        self.canvas.create_text(
            sx, sy,
            text="S",
            fill="#70e58a",
            font=("Segoe UI", 12, "bold")
        )

        # Goal
        gx = self.goal[0] * CELL + CELL // 2
        gy = self.goal[1] * CELL + CELL // 2

        self.canvas.create_text(
            gx, gy,
            text="G",
            fill="#ffcc66",
            font=("Segoe UI", 12, "bold")
        )

        # Sensors
        self.draw_sensors()

        # Robot
        rx = self.robot_x * CELL + CELL // 2
        ry = self.robot_y * CELL + CELL // 2

        self.canvas.create_oval(
            rx - 11, ry - 11,
            rx + 11, ry + 11,
            fill="#55aee8",
            outline="white",
            width=2
        )

        # Direction arrow
        directions = {
            "NORTH": (0, -13),
            "SOUTH": (0, 13),
            "EAST": (13, 0),
            "WEST": (-13, 0)
        }

        dx, dy = directions[self.robot_dir]

        self.canvas.create_line(
            rx, ry,
            rx + dx,
            ry + dy,
            fill="white",
            width=3,
            arrow=tk.LAST
        )

        self.canvas.create_text(
            rx,
            ry + 22,
            text="ROBOT",
            fill="white",
            font=("Segoe UI", 7, "bold")
        )

        self.update_dashboard()

    # ========================================================
    # SENSOR SYSTEM
    # ========================================================

    def ray_distance(self, dx, dy, max_distance=10):
        x = self.robot_x
        y = self.robot_y

        for distance in range(1, max_distance + 1):
            x += dx
            y += dy

            if not self.is_free(x, y):
                return distance * 10

        return max_distance * 10

    def update_sensors(self):
        directions = {
            "NORTH": (0, -1),
            "SOUTH": (0, 1),
            "EAST": (1, 0),
            "WEST": (-1, 0)
        }

        fx, fy = directions[self.robot_dir]

        if self.robot_dir in ("EAST", "WEST"):
            left = (0, -1) if self.robot_dir == "EAST" else (0, 1)
            right = (0, 1) if self.robot_dir == "EAST" else (0, -1)
        else:
            left = (-1, 0) if self.robot_dir == "NORTH" else (1, 0)
            right = (1, 0) if self.robot_dir == "NORTH" else (-1, 0)

        self.sensor_front = self.ray_distance(fx, fy)
        self.sensor_left = self.ray_distance(left[0], left[1])
        self.sensor_right = self.ray_distance(right[0], right[1])

    def draw_sensors(self):
        if not self.sensor_var.get():
            return

        self.update_sensors()

        rx = self.robot_x * CELL + CELL // 2
        ry = self.robot_y * CELL + CELL // 2

        directions = {
            "NORTH": (0, -1),
            "SOUTH": (0, 1),
            "EAST": (1, 0),
            "WEST": (-1, 0)
        }

        dx, dy = directions[self.robot_dir]

        # Front sensor
        self.canvas.create_line(
            rx,
            ry,
            rx + dx * self.sensor_front * 2,
            ry + dy * self.sensor_front * 2,
            fill="#ffcf5a",
            width=2
        )

    # ========================================================
    # A* PATHFINDING
    # ========================================================

    def heuristic(self, a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    def get_neighbors(self, node):
        x, y = node

        neighbors = [
            (x + 1, y),
            (x - 1, y),
            (x, y + 1),
            (x, y - 1)
        ]

        return [
            n for n in neighbors
            if 0 <= n[0] < GRID_W
            and 0 <= n[1] < GRID_H
            and self.grid[n[1]][n[0]] != OBSTACLE
        ]

    def a_star(self, start, goal):
        open_set = []
        heapq.heappush(open_set, (0, start))

        came_from = {}
        g_score = {start: 0}
        f_score = {start: self.heuristic(start, goal)}

        while open_set:
            _, current = heapq.heappop(open_set)

            if current == goal:
                path = [current]

                while current in came_from:
                    current = came_from[current]
                    path.append(current)

                path.reverse()
                return path

            for neighbor in self.get_neighbors(current):
                tentative_g = g_score[current] + 1

                if tentative_g < g_score.get(neighbor, float("inf")):
                    came_from[neighbor] = current
                    g_score[neighbor] = tentative_g

                    f = tentative_g + self.heuristic(neighbor, goal)
                    f_score[neighbor] = f

                    heapq.heappush(open_set, (f, neighbor))

        return []

    def calculate_path(self):
        self.path = self.a_star(
            (self.robot_x, self.robot_y),
            self.goal
        )

        if self.path:
            self.path_index = 0
            self.log(f"A* path calculated: {len(self.path)} nodes")
            self.status_label.config(text="PATH READY", fg="#65e5e5")
        else:
            self.log("No path found")
            self.status_label.config(text="NO PATH", fg="#ff6666")

        self.update_display()

    # ========================================================
    # ROBOT MOVEMENT
    # ========================================================

    def start_robot(self):
        if self.running:
            return

        if not self.path:
            self.calculate_path()

        if not self.path:
            return

        self.running = True
        self.auto_mode = True
        self.status_label.config(text="AUTONOMOUS", fg="#65e572")
        self.log("Autonomous navigation started")

        self.auto_step()

    def stop_robot(self):
        self.running = False
        self.status_label.config(text="STOPPED", fg="#ffcc66")
        self.log("Robot stopped")

    def auto_step(self):
        if not self.running:
            return

        if self.battery <= 0:
            self.running = False
            self.status_label.config(text="BATTERY EMPTY", fg="#ff6666")
            self.log("Battery depleted")
            return

        if self.robot_x == self.goal[0] and self.robot_y == self.goal[1]:
            self.running = False
            self.status_label.config(text="MISSION COMPLETE", fg="#65e572")
            self.log("Target reached successfully")
            return

        # Recalculate path if needed
        self.path = self.a_star(
            (self.robot_x, self.robot_y),
            self.goal
        )

        if not self.path:
            self.running = False
            self.status_label.config(text="PATH BLOCKED", fg="#ff6666")
            self.log("Navigation stopped: no valid path")
            return

        if len(self.path) >= 2:
            next_pos = self.path[1]
            nx, ny = next_pos

            dx = nx - self.robot_x
            dy = ny - self.robot_y

            self.update_direction(dx, dy)

            if self.grid[ny][nx] == OBSTACLE:
                self.collisions += 1
                self.log("Obstacle detected")
                self.calculate_path()
            else:
                self.robot_x = nx
                self.robot_y = ny
                self.distance += 1.0
                self.battery = max(0, self.battery - 0.08)

        self.update_display()

        self.root.after(self.speed, self.auto_step)

    def update_direction(self, dx, dy):
        if dx > 0:
            self.robot_dir = "EAST"
        elif dx < 0:
            self.robot_dir = "WEST"
        elif dy > 0:
            self.robot_dir = "SOUTH"
        elif dy < 0:
            self.robot_dir = "NORTH"

    def manual_move(self, dx, dy):
        if self.running:
            return

        nx = self.robot_x + dx
        ny = self.robot_y + dy

        if self.is_free(nx, ny):
            self.robot_x = nx
            self.robot_y = ny
            self.distance += 1
            self.battery = max(0, self.battery - 0.1)
            self.update_direction(dx, dy)
            self.log(f"Manual move -> ({nx}, {ny})")
        else:
            self.collisions += 1
            self.log("Manual movement blocked by obstacle")

        self.update_display()

    def is_free(self, x, y):
        if x < 0 or y < 0 or x >= GRID_W or y >= GRID_H:
            return False

        return self.grid[y][x] != OBSTACLE

    # ========================================================
    # RESET / MAP
    # ========================================================

    def reset_robot(self):
        self.running = False

        self.robot_x, self.robot_y = self.start
        self.robot_dir = "EAST"

        self.battery = 100.0
        self.distance = 0.0
        self.collisions = 0
        self.path = []

        self.status_label.config(text="READY", fg="#65e572")

        self.log("Robot reset")
        self.update_display()

    def random_map(self):
        self.running = False

        self.grid = [[EMPTY for _ in range(GRID_W)] for _ in range(GRID_H)]

        for y in range(GRID_H):
            for x in range(GRID_W):
                if (
                    x == 0
                    or y == 0
                    or x == GRID_W - 1
                    or y == GRID_H - 1
                ):
                    self.grid[y][x] = OBSTACLE
                elif random.random() < 0.16:
                    self.grid[y][x] = OBSTACLE

        self.grid[self.start[1]][self.start[0]] = START
        self.grid[self.goal[1]][self.goal[0]] = GOAL

        self.robot_x, self.robot_y = self.start
        self.path = []

        self.status_label.config(text="NEW MAP", fg="#65e5e5")
        self.log("New random map generated")

        self.update_display()

    # ========================================================
    # SAVE / LOAD
    # ========================================================

    def save_map(self):
        filename = filedialog.asksaveasfilename(
            defaultextension=".json",
            filetypes=[("JSON files", "*.json")]
        )

        if not filename:
            return

        data = {
            "version": VERSION,
            "width": GRID_W,
            "height": GRID_H,
            "grid": self.grid,
            "start": list(self.start),
            "goal": list(self.goal)
        }

        try:
            with open(filename, "w", encoding="utf-8") as file:
                json.dump(data, file, indent=2)

            self.log("Map saved successfully")
            messagebox.showinfo("RoboPilot", "Map saved successfully.")

        except Exception as e:
            messagebox.showerror("Error", str(e))

    def load_map(self):
        filename = filedialog.askopenfilename(
            filetypes=[("JSON files", "*.json")]
        )

        if not filename:
            return

        try:
            with open(filename, "r", encoding="utf-8") as file:
                data = json.load(file)

            grid = data.get("grid")

            if not isinstance(grid, list):
                raise ValueError("Invalid map file")

            if len(grid) != GRID_H:
                raise ValueError("Map height mismatch")

            self.grid = grid

            self.start = tuple(data.get("start", [2, 2]))
            self.goal = tuple(data.get("goal", [20, 15]))

            self.robot_x, self.robot_y = self.start
            self.path = []
            self.running = False

            self.log("Map loaded successfully")
            self.update_display()

        except Exception as e:
            messagebox.showerror("Load Error", str(e))

    # ========================================================
    # SPEED
    # ========================================================

    def change_speed(self, value):
        try:
            self.speed = int(float(value))
        except ValueError:
            self.speed = 120

    # ========================================================
    # DASHBOARD
    # ========================================================

    def update_dashboard(self):
        self.update_sensors()

        elapsed = int(time.time() - self.start_time)

        minutes = elapsed // 60
        seconds = elapsed % 60

        if self.robot_x == self.goal[0] and self.robot_y == self.goal[1]:
            mode = "MISSION COMPLETE"
        elif self.running:
            mode = "AUTONOMOUS"
        else:
            mode = "MANUAL / IDLE"

        info = (
            f"Position       : ({self.robot_x}, {self.robot_y})\n"
            f"Direction      : {self.robot_dir}\n"
            f"Mode           : {mode}\n"
            f"Speed          : {self.speed} ms\n"
            f"Battery        : {self.battery:.1f}%\n"
            f"Distance       : {self.distance:.1f} m\n"
            f"Collisions     : {self.collisions}\n"
            f"Runtime        : {minutes:02d}:{seconds:02d}\n"
            f"\n"
            f"Virtual Sensors\n"
            f"Front          : {self.sensor_front} cm\n"
            f"Left           : {self.sensor_left} cm\n"
            f"Right          : {self.sensor_right} cm\n"
            f"\n"
            f"Navigation\n"
            f"Algorithm      : A*\n"
            f"Path Nodes     : {len(self.path)}\n"
            f"Target         : {self.goal}"
        )

        self.info_label.config(text=info)


