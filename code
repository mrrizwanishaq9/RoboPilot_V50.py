VERSION = "RoboPilot V50"
GRID_W = 24
GRID_H = 18
CELL = 32

EMPTY = 0
OBSTACLE = 1
START = 2
GOAL = 3


class RoboPilot:
    def __init__(self, root):
        self.root = root
        self.root.title("RoboPilot V50 - AI Robotics Simulation Lab")
        self.root.geometry("1180x760")
        self.root.minsize(1000, 680)

        self.running = False
        self.auto_mode = True
        self.manual_mode = False
        self.show_sensors = True
        self.show_path = True

        self.speed = 120
        self.battery = 100.0
        self.distance = 0.0
        self.collisions = 0
        self.start_time = time.time()

        self.robot_x = 2
        self.robot_y = 2
        self.robot_dir = "EAST"

        self.start = (2, 2)
        self.goal = (20, 15)

        self.path = []
        self.path_index = 0

        self.sensor_front = 0
        self.sensor_left = 0
        self.sensor_right = 0

        self.grid = [[EMPTY for _ in range(GRID_W)] for _ in range(GRID_H)]

        self.build_default_map()
        self.build_gui()
        self.update_display()

    # ========================================================
    # MAP
    # ========================================================

    def build_default_map(self):
        self.grid = [[EMPTY for _ in range(GRID_W)] for _ in range(GRID_H)]

        # Border
        for y in range(GRID_H):
            self.grid[y][0] = OBSTACLE
            self.grid[y][GRID_W - 1] = OBSTACLE

        for x in range(GRID_W):
            self.grid[0][x] = OBSTACLE
            self.grid[GRID_H - 1][x] = OBSTACLE

        # Random deterministic obstacles
        blocks = [
            (6, 2), (6, 3), (6, 4), (6, 5), (6, 6),
            (10, 5), (11, 5), (12, 5), (13, 5),
            (15, 8), (15, 9), (15, 10), (15, 11),
            (5, 11), (6, 11), (7, 11), (8, 11),
            (18, 3), (18, 4), (18, 5),
            (20, 8), (21, 8), (20, 9), (21, 9),
            (11, 13), (12, 13), (13, 13), (14, 13)
        ]

        for x, y in blocks:
            if (x, y) != self.start and (x, y) != self.goal:
                self.grid[y][x] = OBSTACLE

        self.grid[self.start[1]][self.start[0]] = START
        self.grid[self.goal[1]][self.goal[0]] = GOAL

